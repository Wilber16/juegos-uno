{
  "rules": {
    ".read": false,
    ".write": false,
    "chapalo": {
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || (newData.child('players').child(auth.uid).exists() && data.child('status').val() === 'lobby'))",
          ".validate": "$code.matches(/^[A-Z]{4}$/)"
        }
      }
    }
  }
}
